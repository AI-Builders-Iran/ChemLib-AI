# Required: primary LLM provider (extraction, RAG chat/compare, and OCR all use this)
GEMINI_API_KEY=

# Optional: fallback LLM provider, used automatically if Gemini fails
OPENROUTER_API_KEY=

# Library admin password. Required to open the admin panel of the Streamlit app
# (http://localhost:8501/?mode=admin); without it the panel stays locked.
# When set, POST /api/v1/ingest also requires it in the X-Admin-Password header.
ADMIN_PASSWORD=

# Windows only: full path to poppler's bin/ folder (needed by pdf2image).
# Leave empty on Linux/Mac once poppler-utils is installed via apt/brew —
# it will already be on PATH.
# Example (Windows): C:\poppler\poppler-24.08.0\Library\bin
POPPLER_PATH=
